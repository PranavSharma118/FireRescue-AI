# ==========================================================
# FireRescue AI - Backend Configuration (.env)
# ==========================================================

# PostgreSQL Database Configuration
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=firerescue_AI
DATABASE_USER=postgres
DATABASE_PASSWORD=YOUR_POSTGRES_PASSWORD_HERE

# Full Database URL (SQLAlchemy)
DATABASE_URL=postgresql://postgres:YOUR_POSTGRES_PASSWORD_HERE@localhost:5432/firerescue_AI

# JWT Authentication
SECRET_KEY=replace_with_a_secure_secret_key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Server Environment
ENVIRONMENT=development
PORT=8000
HOST=0.0.0.0

# CORS Allowed Origins (Comma separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# AI Prediction Engine
AI_PREDICTION_ENGINE=enabled
CONFIDENCE_THRESHOLD=85
